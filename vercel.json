{
  "version": 2,
  "name": "picassonova",
  "builds": [
    {
      "src": "dist/apps/files/src/main.js",
      "use": "@vercel/node",
      "config": { "distDir": "dist/apps/files" }
    },
    {
      "src": "dist/apps/gateway/src/main.js",
      "use": "@vercel/node",
      "config": { "distDir": "dist/apps/gateway" }
    }
  ],
  "routes": [
    {
      "src": "/api/v1/files/(.*)",
      "dest": "dist/apps/files/main.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH"]
    },
    {
      "src": "/api/v1/gateway/(.*)",
      "dest": "dist/apps/gateway/main.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH"]
    }
  ]
}
