{
  "name": "gateway",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "start-dev:gateway": "cross-env ENV=DEVELOPMENT nest start gateway --watch",
    "start-dev:files": "cross-env ENV=DEVELOPMENT nest start files --watch",
    "start:all": "concurrently \"yarn start-dev:gateway\" \"yarn start-dev:files\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/gateway/test/jest-e2e.json",
    "build:gateway": "nest build gateway",
    "start:gateway": "node dist/apps/gateway/main",
    "build:files": "nest build files",
    "start:files": "node dist/apps/files/main",
    "migrate:add": "npx prisma migrate dev --name init --schema=apps/gateway/prisma/schema.prisma",
    "migrate:deploy": "npx prisma migrate deploy --schema=apps/gateway/prisma/schema.prisma",
    "prisma-generate": "npx prisma generate --schema=./apps/gateway/prisma/schema.prisma",
    "prisma-studio": "npx prisma studio --schema=apps/gateway/prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/axios": "3.1.2",
    "@nestjs/common": "10.4.7",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.7",
    "@nestjs/cqrs": "10.2.8",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/microservices": "10.4.7",
    "@nestjs/platform-express": "10.4.7",
    "@nestjs/swagger": "8.0.7",
    "@prisma/client": "5.23.0-integration-otel-peer-deps.1",
    "axios": "1.7.8",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "nodemailer": "6.9.14",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.7",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.7",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.7",
    "@types/date-fns": "2.6.3",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/jwt-simple": "0.5.36",
    "@types/node": "20.17.6",
    "@types/nodemailer": "6.4.16",
    "@types/passport": "1.0.17",
    "@types/passport-http": "0.3.11",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "jest": "29.7.0",
    "prettier": "3.3.3",
    "prisma": "5.23.0-integration-otel-peer-deps.1",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/"
    ]
  }
}
